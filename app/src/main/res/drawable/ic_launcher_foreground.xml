        android:width="66dp"
        android:height="66dp"
        android:gravity="center">
        <bitmap
            android:antialias="true"
            android:filter="true"
            android:gravity="fill"
            android:src="@drawable/deodato_brand_mark" />
    </item>
</layer-list>
